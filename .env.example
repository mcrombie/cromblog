# Canonical Cromblog origin used for social metadata.
NEXT_PUBLIC_SITE_URL=

# Verified HTTPS URL for the separately hosted Archivist public demo.
# Optional: defaults to https://archivist.mcrombie.com when blank. Set this to
# point a build at a different host, such as a staging deploy.
NEXT_PUBLIC_ARCHIVIST_URL=

# Server-only origin for the separately hosted Clashvergence demo API.
# Keep the OpenAI API key in that Python service; it must never be exposed here.
# Local example: http://127.0.0.1:18766
CLASHVERGENCE_API_URL=
# Same server-only high-entropy value configured on the Python demo service.
CLASHVERGENCE_DEMO_PROXY_SECRET=
