{
  "name": "cromblog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "description": "A quiet editorial portfolio built with Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "doodles:vibe": "py -3.14 scripts/build-doodle-vibe-assets.py",
    "doodles:vibe:check": "py -3.14 scripts/build-doodle-vibe-assets.py --check",
    "doodles:field": "py -3.14 scripts/build-doodle-vibe-field.py",
    "doodles:field:check": "py -3.14 scripts/build-doodle-vibe-field.py --check",
    "doodles:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-doodle-assets.ps1",
    "doodles:review": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review-doodle-assets.ps1",
    "start": "next start",
    "lint": "eslint app components content lib proxy.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "thumbs": "node scripts/make-doodle-thumbs.mjs",
    "prebuild": "node scripts/check-doodle-thumbs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "^0.186.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.16",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2"
  }
}
